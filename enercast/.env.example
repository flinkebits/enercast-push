# Zugangsdaten für https://rest-api.enercast.de
# Kopieren nach .env und ausfüllen. .env wird nicht versioniert.
ENERCAST_USERNAME=
ENERCAST_PASSWORD=
# Account-Id ist der Benutzername. Nur ausfüllen, wenn eine andere Id gelten soll.
ENERCAST_ACCOUNT_ID=

ENERCAST_PLANT_KEY=Feld0

# Optional: SQLite-Cache (Default: data/modbus_intervals.db neben den Skripten)
# ENERCAST_INTERVAL_DB=/var/lib/zaehler/enercast/modbus_intervals.db