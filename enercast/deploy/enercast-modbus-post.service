[Unit]
Description=enercast Modbus post (Cache to cloud)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zaehler
Group=zaehler
WorkingDirectory=/home/zaehler/enercast/enercast
ExecStart=/usr/bin/python3 /home/zaehler/enercast/enercast/post_data2enercast.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
