# Zugangsdaten FusionSolar Northbound.
# Kopieren nach .env und ausfüllen. .env wird nicht versioniert.
# Host ist die Portal-Domain nach dem Web-Login, z. B. eu5.fusionsolar.huawei.com
FUSIONSOLAR_HOST=eu5.fusionsolar.huawei.com
FUSIONSOLAR_USER=huberapinutzer
FUSIONSOLAR_SYSTEM_CODE=

# Optional, sonst die einzige gebundene Anlage (Name oder plantCode):
# FUSIONSOLAR_PLANT=

# Optional: Abstand zwischen API-Aufrufen in Sekunden (Standard 2, bei 407/403/429 wird 61 s gewartet):
# FUSIONSOLAR_GAP_SECONDS=2
